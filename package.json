{
  "name": "smart-learning-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Based Curriculum-Aware Learning & Teaching System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "python -m uvicorn app.main:app --app-dir apps/local-api --reload --port 8000",
    "dev": "npm run dev:web",
    "build:web": "npm run build --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web"
  },
  "keywords": [
    "ai",
    "education",
    "rag",
    "local-first",
    "ollama",
    "curriculum-aware"
  ],
